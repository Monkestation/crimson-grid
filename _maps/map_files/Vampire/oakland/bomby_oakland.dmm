"xda" = (
/obj/item/paper/fluff{
	default_raw_text = "They put it on the dollar to mock us. Not a symbol, a signal, a beacon. It watches from the apex, unmoving, unblinking, uncaring. - I covered my mirrors and it still knows. The ocean protects, it protects, it protects."
	},
