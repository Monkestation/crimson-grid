// fires of inferno spellbooks
/obj/item/path_spellbook/fires_of_inferno
	name = "fires of inferno spellbook"
	desc = "A tome containing the secrets of manipulating infernal fire through demonic magic."
	icon = 'modular_vcg/modules/paths/icons/paths.dmi'
	icon_state = "inferno_spellbook"
	path_type = /datum/discipline/path/inferno
	required_discipline = /datum/discipline/dark_thaumaturgy

/obj/item/path_spellbook/fires_of_inferno/level1
	name = "fires of inferno spellbook (level I)"
	desc = "A basic tome teaching the fundamentals of infernal fire manipulation. Allows the Thaumaturge to cast 'Lighter'."
	path_level = 1

/obj/item/path_spellbook/fires_of_inferno/level2
	name = "fires of inferno spellbook (level II)"
	desc = "An intermediate tome revealing deeper secrets of infernal flame control. Allows the Thaumaturge to cast 'Stovetop'."
	path_level = 2

/obj/item/path_spellbook/fires_of_inferno/level3
	name = "fires of inferno spellbook (level III)"
	desc = "An advanced tome containing dangerous infernal fire magic techniques. Allows the Thaumaturge to cast 'Blowtorch'."
	path_level = 3

/obj/item/path_spellbook/fires_of_inferno/level4
	name = "fires of inferno spellbook (level IV)"
	desc = "A master-level tome with devastating infernal flame powers. Allows the Thaumaturge to cast 'Flame-thrower'."
	path_level = 4

/obj/item/path_spellbook/fires_of_inferno/level5
	name = "fires of inferno spellbook (level V)"
	desc = "The ultimate tome of infernal fire mastery, containing the most powerful infernal flame techniques. Allows the Thaumaturge to cast 'Conflagration'."
	path_level = 5
