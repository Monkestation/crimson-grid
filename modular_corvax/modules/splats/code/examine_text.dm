/mob/proc/get_ventrue_blood_sense_text(mob/living/examined)
	if(!HAS_TRAIT(src, TRAIT_VENTRUE_SENSE))
		return null

	if(get_corax_splat(examined))
		return "<span class='danger'>Ваше чувство крови в недоумении. Эта кровь не похожа ни на смертную, ни на витэ. Она легкая, воздушная, с привкусом озона, пыли и старых перьев. В ней слышен шепот теней и эхо чужих секретов. Вы осознаете, что перед вами порождение мира духов — оборотень-ворон.</span>"

	if(get_garou_splat(examined))
		return "<span class='danger'>Ваше чувство крови в смятении. Эта кровь обжигающе-дикая, полная первобытной ярости и звериного мускуса. Она пахнет лесом, кровью и чем-то необузданным. Смертная кровь так не пахнет. Это витэ порождения самой Геи — оборотня.</span>"

	if(!ishuman(examined))
		return null

	var/datum/splat/vampire/kindred/target_kindred = get_kindred_splat(examined)

	if(!target_kindred)
		var/datum/splat/vampire/ghoul/target_ghoul = get_ghoul_splat(examined)
		if(target_ghoul)
			return "<span class='notice'>Ваше чувство крови подсказывает, что перед вами гуль. Кровь [examined.ru_p_them()] пахнет застоявшейся витэ.</span>"
		else
			return "<span class='notice'>Вы чувствуете запах обычной, смертной крови. В ней нет ничего примечательного для вашего рода.</span>"

	var/gen = examined.get_generation()
	var/clan_id = target_kindred.clan?.id
	var/message = "<span class='danger'>Ваше чувство крови обостряется. Кровь [examined.ru_p_them()] — это витэ сородича.\n"

	switch(gen)
		if(1 to 3)
			message += "Эта кровь первозданна! От неё веет абсолютной, божественной мощью и леденящей душу Тьмой. Кажется, будто сама вечность смотрит на вас в ответ через эту кровь.\n"
		if(4)
			message += "Кровь невероятно древняя и могучая! Не иначе как от древнейшего из мафусаилов!\n"
		if(5, 6)
			message += "Кровь невероятно густая, тяжелая и обжигающая. Не иначе как от мафусаила или старейшины!\n"
		if(7, 8, 9)
			message += "Кровь сильна и зрела, с благородной горчинкой. Она принадлежит анцилле или старейшине!\n"
		if(10, 11)
			message += "Кровь молодой силы, живая и необузданная. Её владелец, должно быть, ещё молод.\n"
		if(12, 13)
			message += "Сила этой крови угасает, она водяниста. Она принадлежит неонату.\n"
		else
			if(gen >= 14)
				message += "Это витэ слабокровного! В ней почти нет силы.\n"

	if(clan_id)
		switch(clan_id)
			if(VAMPIRE_CLAN_BRUJAH)
				message += "Кровь острая, с привкусом железа и пыли. Она будто пульсирует отголоском ярости.\n"
			if(VAMPIRE_CLAN_GANGREL)
				message += "От крови веет чем-то первобытным. Привкус сосновой смолы, дождя и звериного мускуса.\n"
			if(VAMPIRE_CLAN_MALKAVIAN)
				message += "Вкус хаотичный, словно кровь «заикается» на языке. В ней слышны обрывки чужих мыслей и тихий смех.\n"
			if(VAMPIRE_CLAN_NOSFERATU)
				message += "Кровь густая, землистая, с привкусом сырой почвы и склепа. Она давит на язык, как сама тьма.\n"
			if(VAMPIRE_CLAN_TOREADOR)
				message += "Кровь изысканная, с тонкими нотками розы и старого вина. Сквозь сладость пробивается металлический привкус тщеславия.\n"
			if(VAMPIRE_CLAN_TREMERE)
				message += "Кровь холодная, почти стерильная, с привкусом чернил и старой бумаги. В ней чувствуется расчет и чужая воля.\n"
			if(VAMPIRE_CLAN_VENTRUE, VAMPIRE_CLAN_VENTRUE_ANTITRIBU)
				message += "Кровь благородная, с привкусом старой кожи, власти и железной воли. В ней чувствуется тяжесть короны.\n"
			if(VAMPIRE_CLAN_LASOMBRA)
				message += "Кровь тёмная, с привкусом морской соли и холодной тени. Кажется, что она поглощает свет.\n"
			if(VAMPIRE_CLAN_TZIMISCE)
				message += "Витэ изменчива и искажена, с привкусом плоти, костей и древней земли.\n"
			if(VAMPIRE_CLAN_OLD_CLAN_TZIMISCE)
				message += "Эта витэ стара, очень стара, с привкусом мерзлой земли. Она напоминает другую кровь, куда более искажённую...\n"
			if(VAMPIRE_CLAN_CAITIFF)
				message += "Кровь мутная, разбавленная, без четкого стержня. Она словно потеряла свою изначальную суть.\n"

			if(VAMPIRE_CLAN_BANU_HAQIM)
				message += "Кровь сухая, обжигающая, с привкусом пустынного песка и старой стали.\n"
			if(VAMPIRE_CLAN_BANU_HAQIM_VIZIER)
				message += "Кровь терпкая, с привкусом экзотических специй и древних пергаментов.\n"

			if(VAMPIRE_CLAN_SETITE, VAMPIRE_CLAN_WARRIOR_SETITE)
				message += "В этой крови соблазн и искушение. Дурманящая, сладкая, с привкусом змеиного яда.\n"
			if(VAMPIRE_CLAN_TLACIQUE)
				message += "Кровь густая, с привкусом жертвенной крови, обсидиана и влажных джунглей.\n"

			if(VAMPIRE_CLAN_GIOVANNI)
				message += "Кровь холодная, с привкусом ладана, старых денег и могильной земли.\n"
			if(VAMPIRE_CLAN_CAPPADOCIAN)
				message += "Кровь древняя, пыльная, с привкусом мирры и холодных склепов. От нее веет увяданием.\n"
			if(VAMPIRE_CLAN_HARBINGER)
				message += "Кровь некротическая, с привкусом костной пыли и тлена. Она вызывает инстинктивное отвращение.\n"
			if(VAMPIRE_CLAN_SAMEDI)
				message += "Кровь тошнотворная, с привкусом формалина, гниющей плоти и дешевого рома.\n"
			if(VAMPIRE_CLAN_NAGARAJA)
				message += "В этой крови тревожный голод, она холодна, с привкусом пепла и мертвой плоти.\n"

			if(VAMPIRE_CLAN_CITY_GANGREL)
				message += "Кровь с металлическим привкусом асфальта, озона и грязных переулков.\n"
			if(VAMPIRE_CLAN_HEALER_SALUBRI)
				message += "Кровь успокаивающая, чистая, но с горьким привкусом печали и святости.\n"
			if(VAMPIRE_CLAN_WARRIOR_SALUBRI)
				message += "Кровь обжигающая, как священный огонь, полная праведного гнева и боли мучеников.\n"
			if(VAMPIRE_CLAN_DAUGHTERS_OF_CACOPHONY)
				message += "Кровь мелодичная, вибрирующая на языке, словно тихая песня с острой металлической нотой.\n"

			if(VAMPIRE_CLAN_GARGOYLE)
				message += "Кровь каменная, тяжелая и неподатливая, с привкусом гранита и ночного ветра.\n"
			if(VAMPIRE_CLAN_TRUE_BRUJAH)
				message += "Кровь холодна и неподвижна, лишена страсти. В ней чувствуется лишь древняя статика.\n"
			if(VAMPIRE_CLAN_BAALI)
				message += "Кровь оскверненная, с привкусом серы и жертвенной крови. От нее веет безумием и огнем.\n"
			if(VAMPIRE_CLAN_KIASYD)
				message += "Кровь странная, с привкусом лунного света и озона. Она кажется нереальной и пугающе чужой.\n"
			if(VAMPIRE_CLAN_DOMINATE_MALKAVIAN)
				message += "Кровь пронзительно ясная, но с привкусом холодного, расчетливого безумия.\n"

			else
				message += "Происхождение этой крови проследить трудно. Быть может, она принадлежит кому-то из бесклановых?\n"

	message += "</span>"
	return message
